{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Flow Workflow",
  "type": "object",
  "required": ["name", "version", "style", "maturity", "steps"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "style": { "enum": ["pipeline", "recovery_pipeline", "collaborative"] },
    "maturity": { "enum": ["draft", "experimental", "stable", "trusted"] },
    "inputs": { "type": "object" },
    "sessions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/session" }
    },
    "approvals": {
      "type": "object",
      "propertyNames": { "pattern": "^\\S(?:.*\\S)?$" },
      "additionalProperties": { "$ref": "#/$defs/approvalInvalidation" }
    },
    "collaboration": { "$ref": "#/$defs/collaboration" },
    "artifacts": { "type": "object" },
    "steps": {
      "type": "array",
      "items": { "$ref": "#/$defs/step" }
    },
    "short_circuit_if": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_duration_minutes": { "type": "number", "exclusiveMinimum": 0 },
        "max_duration_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "max_frontier_calls": { "type": "number", "exclusiveMinimum": 0 },
        "max_recovery_cycles": { "type": "integer", "minimum": 1 },
        "max_step_attempts": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^\\S(?:.*\\S)?$" },
          "additionalProperties": { "type": "number", "exclusiveMinimum": 0 }
        }
      },
      "allOf": [
        {
          "not": {
            "required": ["max_duration_seconds", "max_duration_minutes"]
          }
        }
      ],
      "patternProperties": {
        "^max_(?!step_attempts$)": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": true
    },
    "policies": {
      "type": "object",
      "properties": {
        "approvals": {
          "type": "object",
          "properties": {
            "required_for": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": true
        },
        "cleanup": { "$ref": "#/$defs/policyMode" },
        "file_scope": { "$ref": "#/$defs/fileScope" },
        "model_usage": {
          "type": "object",
          "properties": {
            "allowed_providers": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": true
        },
        "recovery_limits": { "enum": ["pause", "fail"] },
        "unsafe_operations": { "$ref": "#/$defs/policyMode" }
      },
      "additionalProperties": true
    },
    "notify": { "type": "array" },
    "retention": {
      "type": "object",
      "properties": {
        "on_success": { "$ref": "#/$defs/retentionRule" },
        "on_failure": { "$ref": "#/$defs/retentionRule" },
        "on_cancelled": { "$ref": "#/$defs/retentionRule" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": { "style": { "const": "collaborative" } },
        "required": ["style"]
      },
      "then": {
        "required": ["collaboration"],
        "properties": {
          "collaboration": {
            "required": ["enabled"],
            "properties": { "enabled": { "const": true } }
          },
          "sessions": {
            "additionalProperties": {
              "allOf": [
                { "$ref": "#/$defs/session" },
                { "required": ["role"] }
              ]
            }
          },
          "steps": {
            "type": "array",
            "items": { "$ref": "#/$defs/collaborativeStep" }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "style": { "not": { "const": "recovery_pipeline" } } },
        "required": ["style"]
      },
      "then": {
        "properties": { "short_circuit_if": false }
      }
    },
    {
      "if": {
        "properties": { "style": { "const": "pipeline" } },
        "required": ["style"]
      },
      "then": {
        "properties": {
          "notify": {
            "type": "array",
            "items": { "$ref": "#/$defs/notificationRule" }
          }
        }
      }
    }
  ],
  "$defs": {
    "step": {
      "type": "object",
      "properties": {
        "body": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "branches": { "type": "array", "items": { "$ref": "#/$defs/step" } },
        "allow_overlap": { "type": "boolean" },
        "conflict_policy": {
          "oneOf": [
            { "type": "string", "minLength": 1, "pattern": "\\S" },
            { "type": "object", "minProperties": 1 }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "approval" } }, "required": ["type"] },
          "then": { "$ref": "#/$defs/approvalStep" }
        },
        {
          "if": { "properties": { "type": { "const": "decision_record" } }, "required": ["type"] },
          "then": { "$ref": "#/$defs/decisionRecordStep" }
        }
      ],
      "additionalProperties": true
    },
    "collaborativeStep": {
      "allOf": [
        { "$ref": "#/$defs/step" },
        {
          "type": "object",
          "properties": {
            "body": { "type": "array", "items": { "$ref": "#/$defs/collaborativeStep" } },
            "steps": { "type": "array", "items": { "$ref": "#/$defs/collaborativeStep" } },
            "branches": { "type": "array", "items": { "$ref": "#/$defs/collaborativeStep" } }
          }
        },
        {
          "if": { "properties": { "type": { "const": "parallel" } }, "required": ["type"] },
          "then": {
            "required": ["strategy"],
            "properties": { "strategy": { "$ref": "#/$defs/parallelStrategy" } }
          }
        }
      ]
    },
    "parallelStrategy": { "const": "fail_fast" },
    "artifactPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029])(?!/)(?![A-Za-z]:[\\\\/])(?!\\./)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*[\\\\/]$)(?!.*\\\\)(?!.*//)(?!.*\\{\\{)(?!.*\\}\\})\\S(?:.*\\S)?$"
    },
    "artifactPathList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifactPath" }
    },
    "sessionNameList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "approvalFailurePolicy": {
      "type": "object",
      "properties": {
        "retry": { "type": "integer", "minimum": 0, "maximum": 100 },
        "allowed": { "type": "boolean" },
        "then": { "enum": ["continue", "ignore", "fail", "pause"] }
      },
      "allOf": [
        {
          "if": { "properties": { "then": { "enum": ["continue", "ignore"] } }, "required": ["then"] },
          "then": { "properties": { "allowed": { "const": true } }, "required": ["allowed"] }
        }
      ],
      "additionalProperties": true
    },
    "approvalStep": {
      "required": ["id", "type", "reviewer", "artifacts"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "type": { "const": "approval" },
        "reviewer": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "message": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "artifacts": { "$ref": "#/$defs/artifactPathList" },
        "output": { "$ref": "#/$defs/artifactPath" },
        "outputs": false,
        "on_failure": { "$ref": "#/$defs/approvalFailurePolicy" }
      },
      "allOf": [
        {
          "if": { "properties": { "reviewer": { "const": "human" } }, "required": ["reviewer"] },
          "then": { "properties": { "on_failure": false } }
        }
      ]
    },
    "approvalInvalidation": {
      "type": "object",
      "required": ["invalidated_by"],
      "properties": {
        "invalidated_by": { "$ref": "#/$defs/artifactPathList" }
      },
      "additionalProperties": false
    },
    "decisionRecordStep": {
      "required": ["id", "type", "owner", "topic", "artifacts"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "type": { "const": "decision_record" },
        "owner": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "topic": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "rationale_summary": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "consulted": { "$ref": "#/$defs/sessionNameList" },
        "approved_by": { "$ref": "#/$defs/sessionNameList" },
        "artifacts": { "$ref": "#/$defs/artifactPathList" },
        "output": { "$ref": "#/$defs/artifactPath" },
        "outputs": false,
        "on_failure": false
      }
    },
    "collaboration": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "max_review_cycles": { "type": "integer", "minimum": 1 },
        "on_disagreement": {
          "oneOf": [
            { "type": "string", "enum": ["ask_user", "owner_decides", "fail"] },
            {
              "type": "object",
              "required": ["strategy"],
              "properties": {
                "strategy": { "$ref": "#/$defs/disagreementStrategy" },
                "arbiter": { "type": "string", "minLength": 1, "pattern": "\\S" },
                "max_rounds": { "type": "integer", "minimum": 1, "maximum": 100 }
              },
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "strategy": { "enum": ["arbiter", "arbiter_then_user"] }
                    },
                    "required": ["strategy"]
                  },
                  "then": { "required": ["arbiter", "max_rounds"] },
                  "else": {
                    "not": {
                      "anyOf": [
                        { "required": ["arbiter"] },
                        { "required": ["max_rounds"] }
                      ]
                    }
                  }
                }
              ]
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "disagreementStrategy": {
      "type": "string",
      "enum": ["ask_user", "arbiter", "arbiter_then_user", "owner_decides", "fail"]
    },
    "session": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "role": { "type": "string", "minLength": 1, "pattern": "\\S" },
        "resume": { "type": "boolean" },
        "owns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "authority": { "$ref": "#/$defs/sessionAuthority" },
        "file_scope": { "$ref": "#/$defs/fileScope" }
      },
      "additionalProperties": true
    },
    "sessionAuthority": {
      "type": "object",
      "properties": {
        "can_advise": { "type": "boolean" },
        "can_approve": { "type": "boolean" },
        "can_block": { "type": "boolean" },
        "can_merge": { "type": "boolean" },
        "can_modify_files": { "type": "boolean" },
        "can_pause": { "type": "boolean" },
        "can_request_changes": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "notificationRule": {
      "type": "object",
      "required": ["on", "channels"],
      "properties": {
        "on": {
          "type": "string",
          "minLength": 1
        },
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "required": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "policyMode": {
      "enum": ["allow", "deny", "require_approval"]
    },
    "fileScope": {
      "type": "object",
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        },
        "exclude": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "pattern": "\\S" }
        }
      },
      "additionalProperties": true
    },
    "retentionRule": {
      "type": "object",
      "properties": {
        "keep": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "delete": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "after_days": { "type": "number", "minimum": 0 },
        "keep_all_for_days": { "type": "number", "minimum": 0 },
        "ask_user": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
