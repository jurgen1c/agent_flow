{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jurgen1c/agent_flow/schemas/review.schema.json",
  "title": "Agent Flow Structured Review Result",
  "type": "object",
  "required": ["status", "findings"],
  "properties": {
    "status": {
      "enum": ["approved", "changes_requested", "unresolved"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["summary"],
        "properties": {
          "summary": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
