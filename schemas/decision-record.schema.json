{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Flow Decision Record",
  "type": "object",
  "$defs": {
    "artifactPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!.*[\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029])(?!/)(?![A-Za-z]:[\\\\/])(?!\\./)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*(?:^|/)\\.(?:/|$))(?!.*[\\\\/]$)(?!.*\\\\)(?!.*//)(?!.*\\{\\{)(?!.*\\}\\})\\S(?:.*\\S)?$"
    }
  },
  "required": ["decision_id", "owner", "topic", "rationale_summary", "consulted", "approved_by", "artifacts", "created_at"],
  "properties": {
    "decision_id": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "owner": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "topic": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "rationale_summary": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "consulted": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
    "approved_by": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "\\S" } },
    "artifacts": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/artifactPath" } },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
