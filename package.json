{
  "name": "@jurgen1c/agent-flow",
  "version": "0.1.0",
  "description": "Standalone workflow runtime and CLI for persistent, policy-aware agent pipelines.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jurgen1c/agent_flow.git"
  },
  "keywords": [
    "agent",
    "workflow",
    "pipeline",
    "cli",
    "automation"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-flow": "./dist/agent-flow.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/router.d.ts",
      "import": "./dist/cli/router.js",
      "default": "./dist/cli/router.js"
    },
    "./schemas/config": "./schemas/config.schema.json",
    "./schemas/approval": "./schemas/approval.schema.json",
    "./schemas/challenge": "./schemas/challenge.schema.json",
    "./schemas/consult": "./schemas/consult.schema.json",
    "./schemas/decision-record": "./schemas/decision-record.schema.json",
    "./schemas/disagreement": "./schemas/disagreement.schema.json",
    "./schemas/failure-classification": "./schemas/failure-classification.schema.json",
    "./schemas/review": "./schemas/review.schema.json",
    "./schemas/workflow": "./schemas/workflow.schema.json"
  },
  "files": [
    "dist/",
    "examples/",
    "schemas/",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "audit": "bun audit --audit-level moderate",
    "build": "bun run build:library && bun run build:cli && bun run build:types",
    "build:library": "bun build src/index.ts src/cli/router.ts --target=node --packages=external --outdir=dist",
    "build:cli": "bun build src/cli/index.ts --target=node --packages=external --outfile=dist/agent-flow.js",
    "build:types": "tsc -p tsconfig.build.json",
    "ci": "bun run audit && bun test && bun run lint && bun run typecheck && bun run build",
    "lint": "eslint .",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "dependencies": {
    "@jurgen1c/agent-core": "^0.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^26.0.1",
    "eslint": "^10.5.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.62.0"
  },
  "overrides": {
    "brace-expansion": "^5.0.9"
  },
  "engines": {
    "node": ">=25.9.0"
  }
}
